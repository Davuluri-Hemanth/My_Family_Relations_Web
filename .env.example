# Vercel Project Settings -> Environment Variables
# Never commit the real values to GitHub.

MONGO_URI=mongodb+srv://APP_USER:APP_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=Family_Relations
MONGO_PERSONS_COLLECTION=persons
MONGO_RELATIONS_COLLECTION=relationships
MONGO_USERS_COLLECTION=users

# Generate a long random value; do not reuse your MongoDB password.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=720

ADMIN_USERNAME=admin
# Generate with: python scripts_generate_admin_hash.py
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

MAX_UPLOAD_MB=5
ENABLE_API_DOCS=false
CORS_ORIGINS=
