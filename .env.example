# MongoDB Atlas
MONGO_URI=mongodb+srv://APP_DB_USER:APP_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=MyFamilyRelations
MONGO_DB=Family_Relations
MONGO_PERSONS_COLLECTION=persons
MONGO_RELATIONS_COLLECTION=relationships
MONGO_USERS_COLLECTION=users

# Authentication
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GENERATE_A_BCRYPT_HASH
JWT_EXPIRE_MINUTES=720

# Uploads / optional CORS
MAX_UPLOAD_MB=5
# Leave empty when frontend is served by this same FastAPI service.
CORS_ORIGINS=

# Keep disabled in production unless you specifically need interactive API docs.
ENABLE_API_DOCS=false

# Optional Render tuning
WEB_CONCURRENCY=2
